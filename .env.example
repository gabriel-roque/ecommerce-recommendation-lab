POSTGRES_DB=recommendations
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Internal Docker Compose address. PostgreSQL is not published to the host.
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/recommendations
CORS_ORIGINS=["http://localhost:5173"]
AUTO_CREATE_TABLES=true
SSE_POLL_INTERVAL_SECONDS=0.5
TRAINER_POLL_SECONDS=2
TRAINER_HEARTBEAT_SECONDS=10
TRAINER_HEARTBEAT_TIMEOUT_SECONDS=120
TRAINER_DATABASE_RETRY_SECONDS=2
REQUIRE_FULL_DATASET=true
DATASET_MANIFEST_PATH=/workspace/data/processed/dataset_manifest.json
DATASET_STATS_PATH=/workspace/data/processed/dataset_stats.json
TRAINING_SAMPLES_DIR=/workspace/data/processed/samples
POPULARITY_PATH=/workspace/data/processed/popularity.json
ARTIFACTS_DIR=/workspace/artifacts
RECOMMENDATION_CACHE_TTL_SECONDS=30
RECOMMENDATION_CACHE_MAX_ENTRIES=512
RECOMMENDATION_CANDIDATE_LIMIT=20000
PRELOAD_ACTIVE_MODEL=true
VITE_API_URL=http://localhost:8000
API_PORT=8000
FRONTEND_PORT=5173
